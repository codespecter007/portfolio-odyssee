# Espace admin sur Vercel. Sans DATABASE_URL, le site utilise web/src/content/ et /admin est désactivé.
DATABASE_URL=postgres://utilisateur:motdepasse@hote/base?sslmode=require
BLOB_READ_WRITE_TOKEN=
ADMIN_EMAIL=
# npm run hash-password -- "mot de passe" (entre apostrophes ici, le hash contient des $)
ADMIN_PASSWORD_HASH=''
# openssl rand -hex 32
JWT_SECRET=
